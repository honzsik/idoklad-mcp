# Copy this file to .env and fill in your values. Never commit .env.

# iDoklad → Settings (Nastavení) → Application/API (API)
IDOKLAD_CLIENT_ID=
IDOKLAD_CLIENT_SECRET=

# https://developer.idoklad.cz → your application → Application ID
IDOKLAD_APPLICATION_ID=

# Read-only by default. Set to false to enable tools that create or change data.
IDOKLAD_READ_ONLY=true
